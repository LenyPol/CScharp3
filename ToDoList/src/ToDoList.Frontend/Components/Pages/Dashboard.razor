@using ToDoList.Frontend.Models
@using System.Linq

<div class="container mt-4">
    <h2 class="mb-3">Dashboard</h2>

    <table class="table table-striped table-hover">
        <thead class="table-light">
            <tr>
                <th>
                    <button @onclick="OrderById" class="btn btn-sm btn-outline-primary w-100">ID</button>
                </th>
                <th>
                    <button @onclick="OrderByName" class="btn btn-sm btn-outline-primary w-100">Name</button>
                </th>
                <th>
                    <button @onclick="OrderByDescription"
                        class="btn btn-sm btn-outline-primary w-100">Description</button>
                </th>
                <th>
                    <button @onclick="OrderByIsCompleted"
                        class="btn btn-sm btn-outline-primary w-100">Completed</button>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in sortedData)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@(item.IsCompleted ? "Ano" : "Ne")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<ToDoItemView> testData = new()
{
new ToDoItemView(1, "Nakoupit potraviny", "Mléko, chléb, vejce", false),
new ToDoItemView(2, "Dokončit projekt", "Implementovat všechny funkce", true),
new ToDoItemView(3, "Zavolat mamince", "Domluvit víkend", false),
new ToDoItemView(4, "Cvičit", "Běhání v parku", false),
new ToDoItemView(5, "Přečíst knihu", "Kapitola 5", true)
};

    private List<ToDoItemView> sortedData = new();

    protected override void OnInitialized()
    {
        sortedData = testData.ToList();
    }

    private void OrderById()
    {
        sortedData = sortedData.OrderBy(x => x.Id).ToList();
    }

    private void OrderByName()
    {
        sortedData = sortedData.OrderBy(x => x.Name).ToList();
    }
    private void OrderByDescription()
    {
        sortedData = sortedData.OrderBy(x => x.Description).ToList();
    }

    private void OrderByIsCompleted()
    {
        sortedData = sortedData.OrderBy(x => x.IsCompleted).ToList();
    }
}