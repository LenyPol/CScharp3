@using ToDoList.Frontend.Clients
@using ToDoList.Frontend.Models
@using System.Linq

@inject IToDoItemsClient toDoItemsClient
@inject NavigationManager NavigationManager

<div class="container mt-4">
    <h2 class="mb-3">ToDo items dashboard</h2>

    <table class="table table-striped table-hover table-bordered shadow-sm rounded">
        <thead class="table-header-custom">
            <tr>
                <th><button class="btn btn-outline-primary sort-btn rounded-pill px-4" @onclick="OrderById">Sort by
                        Id</button></th>
                <th><button class="btn btn-outline-primary sort-btn rounded-pill px-4" @onclick="OrderByName">Sort by
                        Name</button></th>
                <th>Description</th>
                <th>IsCompleted</th>
                <th>Category</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in sortedData)
            {
                <tr class="table-light">
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@(item.IsCompleted ? "Ano" : "Ne")</td>
                    <td>@item.Category</td>
                    <td><button class="btn btn-outline-primary btn-sm rounded-circle bi bi-pencil"
                            @onclick="() => EditItem(item)"></button>
                        <button class="btn btn-outline-danger btn-sm rounded-circle bi bi-trash"
                            @onclick="() => DeleteItem(item.Id)"></button>
                        <button class="btn btn-outline-success btn-sm rounded-circle"
                            @onclick="() => ToggleCompleted(item)">
                            <i class="bi @(item.IsCompleted ? "bi-arrow-counterclockwise" : "bi-check")"></i></button>
                        <button class="btn btn-outline-info btn-sm rounded-circle bi bi-plus-lg"
                            @onclick="() => AddNewItem()"></button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {

    private List<ToDoItemView> sortedData = new();

    protected override async Task OnInitializedAsync()
    {
        //sortedData = testData.ToList();
        sortedData = await toDoItemsClient.ReadItemsAsync();
    }
    private async Task DeleteItem(int id)
    {
        var deletedItem = await toDoItemsClient.DeleteItemAsync(id);

        if (deletedItem != null)
        {
            sortedData.RemoveAll(item => item.Id == deletedItem.Id);
        }
    }

    private void OrderById()
    {
        sortedData = sortedData.OrderBy(item => item.Id).ToList();
    }

    public void EditItem(ToDoItemView toDoItem)
    {
        NavigationManager.NavigateTo(uri: $"/editToDoItem/{toDoItem.Id}");
    }
    private void OrderByName()
    {
        sortedData = sortedData.OrderBy(item => item.Name).ToList();
    }
    private void OrderByDescription()
    {
        sortedData = sortedData.OrderBy(item => item.Description).ToList();
    }

    private void OrderByIsCompleted()
    {
        sortedData = sortedData.OrderBy(item => item.IsCompleted).ToList();
    }
    private void OrderByCategory()
    {
        sortedData = sortedData.OrderBy(item => item.Category).ToList();
    }
    private async Task ToggleCompleted(ToDoItemView item)
    {
        item.IsCompleted = !item.IsCompleted;
        await toDoItemsClient.UpdateItemAsync(item);
        StateHasChanged();
    }
    private void AddNewItem()
    {
        NavigationManager.NavigateTo("/addToDoItem");
    }
}