@using ToDoList.Frontend.Clients
@using ToDoList.Frontend.Models
@using System.Linq

@inject IToDoItemsClient toDoItemsClient
@inject NavigationManager NavigationManager

<div class="container mt-4">
    <h2 class="mb-3">ToDo items dashboard</h2>

    <table class="table table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th><button class="btn btn-secondary" @onclick="OrderById">Sort by Id</button></th>
                <th><button class="btn btn-primary" @onclick="OrderByName">Sort by Name</button></th>
                <th>Description</th>
                <th>IsCompleted</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in sortedData)
            {
                <tr class="table-light">
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@(item.IsCompleted ? "Ano" : "Ne")</td>
                    <td><button class="btn btn success" @onclick="() => EditItem(item)">Edit</button></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {

    private List<ToDoItemView> sortedData = new();

    protected override async Task OnInitializedAsync()
    {
        //sortedData = testData.ToList();
        sortedData = await toDoItemsClient.ReadItemsAsync();
    }

    private void OrderById()
    {
        sortedData = sortedData.OrderBy(item => item.Id).ToList();
    }

    public void EditItem(ToDoItemView toDoItem)
    {
        NavigationManager.NavigateTo(uri: $"/editToDoItem/{toDoItem.Id}");
    }
    private void OrderByName()
    {
        sortedData = sortedData.OrderBy(item => item.Name).ToList();
    }
    private void OrderByDescription()
    {
        sortedData = sortedData.OrderBy(item => item.Description).ToList();
    }

    private void OrderByIsCompleted()
    {
        sortedData = sortedData.OrderBy(item => item.IsCompleted).ToList();
    }
}